{
	"name": "react-bun1",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"preinstall": "bun audit",
		"dev": "bun --hot src/index.ts",
		"build": "bun ./build.ts",
		"build-cli": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
		"start": "NODE_ENV=production bun src/index.ts",
		"preview": "bun script/serve.ts",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
